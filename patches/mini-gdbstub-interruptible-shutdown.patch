+
+static int socket_poll_interruptible(int socket_fd,
+                                     int timeout,
+                                     int events,
+                                     conn_should_abort_fn should_abort,
+                                     void *opaque)
+{
+    int waited = 0;
+
+    for (;;) {
+        struct pollfd pfd = (struct pollfd){
+            .fd = socket_fd,
+            .events = events,
+        };
+        int slice = timeout < 0 ? 100 : timeout - waited;
+
+        if (conn_abort_requested(should_abort, opaque)) {
+            errno = ECANCELED;
+            return -1;
+        }
+        if (timeout >= 0 && slice > 100)
+            slice = 100;
+
+        int ret = poll(&pfd, 1, slice);
+        if (ret < 0) {
+            if (errno == EINTR)
+                continue;
+            return -1;
+        }
+        if (ret > 0) {
+            short ready = events | POLLERR | POLLHUP | POLLNVAL;
+            return (pfd.revents & ready) ? 1 : 0;
+        }
+        if (timeout >= 0) {
+            waited += slice;
+            if (waited >= timeout)
+                return 0;
+        }
+    }
+}
 
-    return (poll(&pfd, 1, timeout) > 0) && (pfd.revents & events);
+static bool socket_poll(int socket_fd, int timeout, int events)
+{
+    return socket_poll_interruptible(socket_fd, timeout, events, NULL, NULL) >
